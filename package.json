{
  "name": "colo",
  "private": true,
  "version": "2.2.0",
  "description": "COLO — Cambia iconos de carpetas y accesos directos en Windows",
  "main": "main.cjs",
  "author": "COLO",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "wait-on tcp:5173 && electron .",
    "start": "concurrently \"npm run dev\" \"npm run electron\"",
    "dist": "npm run build && electron-builder --win --config electron-builder.yml",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "rcedit": "^5.0.2",
    "sharp": "^0.33.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
